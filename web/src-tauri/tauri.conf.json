{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Doc2Audiobook",
  "version": "1.0.0",
  "identifier": "com.doc2audiobook.desktop",
  "build": {
    "frontendDist": "../desktop-shell",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["desktop-remote-dialog"],
      "csp": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
